# Supabase — leave blank to run on built-in mock data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated trusted emails allowed to bootstrap the first administrator.
# Remove an email after that person has an app_users profile.
BOOTSTRAP_ADMIN_EMAILS=

# Kissflow Process API — set KISSFLOW_ONLY=true to keep Supabase configured
# but use only live Kissflow records throughout the dashboard.
KISSFLOW_SUBDOMAIN=
KISSFLOW_ACCOUNT_ID=
KISSFLOW_PROCESS_ID=
KISSFLOW_ACCESS_KEY_ID=
KISSFLOW_ACCESS_KEY_SECRET=
KISSFLOW_ONLY=false

# Shared secret Kissflow must send in the X-Webhook-Secret header
KISSFLOW_WEBHOOK_SECRET=change-me
